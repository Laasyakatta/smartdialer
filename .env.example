# Copy this file to .env in the repository root to override local defaults.
# Keep real credentials out of Git. The current mock-provider demo needs none.

# API settings
PROJECT_NAME=SmartDialer
API_V1_STR=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite database (default is under backend/data/)
DATABASE_URL=sqlite:///./backend/data/smartdialer.db

# Mock telecom provider behavior
PROVIDER_A_TIMEOUT_SEC=3.0
PROVIDER_A_FAILURE_RATE=0.02
PROVIDER_B_TIMEOUT_SEC=8.0
PROVIDER_B_FAILURE_RATE=0.15
PROVIDER_B_DUP_RATE=0.10
PROVIDER_B_OUT_OF_ORDER_RATE=0.10

# Safety Controller
STALE_RESERVATION_TIMEOUT_SEC=45
MAX_SYSTEM_CONCURRENT_CALLS=500
DEFAULT_SAFETY_MARGIN=0.15

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME_SEC=15
